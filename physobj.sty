%Operators
\newcommand{\dif}{\textbf{d}}
\newcommand{\frun}[1]{\left(\frac{\Um}{\Upsilon}\right)^{#1}}
\newcommand{\units}[1]{\mspace{3mu}\left[#1\right]}
\newcommand{\tab}{\mspace{20mu}}
\newcommand{\diff}[2]{\frac{\dif #1}{\dif #2}}
\newcommand{\dff}[3]{\frac{\dif{^#3} #1}{\dif {#2}^{#3}}}
\newcommand{\frcu}[3]{\units{\frac{#1}{#2}\frun{#3}}}
